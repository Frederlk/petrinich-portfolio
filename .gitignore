# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.pnpm-debug.log*

# local env files — only `.env.example` is tracked
.env*

# secret-shaped files in any other naming (`prod.env`, keys, certificates, service accounts)
*.env
*.key
*.p12
*.pfx
*service-account*.json
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# playwright
.playwright/
.playwright-*/
auth.json

# claude code local-only files
.claude/**/*.local.*

# Claude Code worktrees (transient, never committed)
.claude/worktrees/

# The one place a throwaway goes — probe scripts, HTML dumps, JSON samples, `.bak` files. Deleted once its question is answered; nothing in there is evidence.
.scratch/
/.claude/_projects/

# Internal CV material (client names, job-search notes, decision logs, photo originals). Lives only on this machine: `private/README.md` is its index.
/private/

# Agent tooling (rules, hooks, vendored skills, settings): kept on this machine only.
/.claude/
