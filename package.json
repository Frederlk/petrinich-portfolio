{
  "name": "petrinich-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check:helpers": "bun ux-mind-helpers check-no-memo-carveout && bun ux-mind-helpers check-icon-button-label",
    "check:articles": "bun scripts/check/case-studies.ts",
    "check:paths": "bun scripts/check/dead-paths.ts",
    "check:rules": "bun scripts/check/code-rules.ts",
    "cv:pdf": "bun scripts/cv-pdf.ts",
    "check:workflows": "uvx zizmor==1.30.1 .github",
    "codemod": "bun ux-mind-helpers",
    "codemod:fix-imports": "bun ux-mind-helpers fix-relative-imports --src . --alias ~/",
    "codemod:react-imports": "bun ux-mind-helpers react-namespace-imports",
    "deps": "bunx npm-check-updates --format group --cooldown 2",
    "deps:all": "bun deps -u",
    "deps:minor": "bun deps -u --target minor",
    "dev": "next dev --port 4224",
    "format": "bun format:write && bun typecheck",
    "format:check": "bun oxfmt --check .",
    "format:write": "bun oxfmt --write .",
    "gates": "sh scripts/check/gates.sh",
    "knip": "knip",
    "lint": "bun oxlint --type-aware --report-unused-disable-directives-severity=error && bun check:helpers",
    "lint:fresh": "bun pm cache rm && bun lint",
    "prepare": "husky",
    "shadcn": "bunx shadcn@canary",
    "start": "next start --port 4224",
    "sync:github": "bun scripts/sync-github.ts",
    "linkedin": "bun scripts/linkedin.ts",
    "test": "bun test scripts",
    "typecheck": "tsc --noEmit",
    "verify": "bun scripts/verify/section.mjs",
    "resume:validate": "bun scripts/validate-resume.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@igorkowalczyk/is-browser": "^5.1.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "nuqs": "^2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tslog": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@shadcn/lint": "0.2.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "oxfmt": "0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tailwindcss": "1.17.1",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "8.1.0",
    "ux-mind-helpers": "^1.7.1"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
